<Window x:Class="QemuGaGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anti Shutdown Guard"
        Width="1024"
        Height="720"
        MinWidth="900"
        MinHeight="500"
        Background="#081019"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111B26" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0D1620" />
        <SolidColorBrush x:Key="LineBrush" Color="#223243" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#39D0A5" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F3C969" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF7D72" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#081019" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="#162333" BorderBrush="#28405A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB7FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="58" Height="30">
                            <Border x:Name="Track" CornerRadius="15" Background="#53606D" BorderBrush="#6A7886" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="24" Height="24" Margin="3" HorizontalAlignment="Left" Fill="#E8EEF5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#081019" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="#24415B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="440" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- ================= HEADER CARD ================= -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="90" Height="90" CornerRadius="20" Background="#132234" BorderBrush="#23415B" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AS" Foreground="{StaticResource AccentBrush}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Guard" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Anti Shutdown Guard" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Kontrol terpusat untuk mengelola QEMU Guest Agent dan kebijakan power Windows agar sesi tidak terputus."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="15" />
                    </StackPanel>

                    <Border Grid.Column="3" CornerRadius="999" Padding="16,10" Background="#132738" BorderBrush="#22405B" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ServiceBadgeText" Text="Checking" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- ================= INTERACTIVE TOGGLES ================= -->
            <TextBlock Text="Protection Controls" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,32,0,12"/>
            
            <WrapPanel Margin="-6">
                
                <!-- HUMAN MOUSE MOVER -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Human Mouse Mover" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="MouseMoverToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="MouseMoverToggle_OnClick" />
                        </Grid>
                        <!-- Status is visible only when checked -->
                        <Expander Header="Lihat Status Koordinat &amp; Log" IsExpanded="{Binding IsChecked, ElementName=MouseMoverToggle}">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock x:Name="MouseMoverToggleStatusText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="13" Text="OFF: idle" />
                                <TextBlock x:Name="MouseMoverCoordinateText" Margin="0,4,0,0" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="13" Text="" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- QEMU GUEST AGENT -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="QEMU Guest Agent Service" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="QemuServiceToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="QemuServiceToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=QemuServiceToggle}">
                            <TextBlock x:Name="QemuToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" Text="Checking" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- AC POWER GUARD -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AC Power Button Guard" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="AcPowerGuardToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="AcPowerGuardToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=AcPowerGuardToggle}">
                            <TextBlock x:Name="AcPowerToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- KEEP AWAKE -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Keep-Awake Background Task" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="KeepAwakeToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="KeepAwakeToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=KeepAwakeToggle}">
                            <TextBlock x:Name="KeepAwakeToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- SLEEP NEVER -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sleep Timeout (Never)" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="SleepNeverToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="SleepNeverToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=SleepNeverToggle}">
                            <TextBlock x:Name="SleepNeverToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- POWER MENU GUARD -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hide Power Menu Options" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="PowerMenuGuardToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="PowerMenuGuardToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=PowerMenuGuardToggle}">
                            <TextBlock x:Name="PowerMenuToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- VM SHUTDOWN BLOCK -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Block VM Guest Shutdown Service" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="VmShutdownBlockToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="VmShutdownBlockToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=VmShutdownBlockToggle}">
                            <TextBlock x:Name="VmShutdownToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- WINDOWS UPDATE BLOCK -->
                <Border Style="{StaticResource ToggleRowStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Block Windows Update Restart" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="WindowsUpdateRestartToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" Click="WindowsUpdateRestartToggle_OnClick" />
                        </Grid>
                        <Expander Header="Detail Log Status" IsExpanded="{Binding IsChecked, ElementName=WindowsUpdateRestartToggle}">
                            <TextBlock x:Name="WindowsUpdateToggleStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Expander>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- ================= ACTION BUTTONS ================= -->
            <TextBlock Text="Quick Actions" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,32,0,12"/>
            <WrapPanel Margin="-6">
                <Button x:Name="ApplyHardeningButton" Width="200" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyHardeningButton_OnClick">Apply Hardening</Button>
                <Button x:Name="ElevateButton" Width="200" Style="{StaticResource SecondaryButtonStyle}" Click="ElevateButton_OnClick">Relaunch as Admin</Button>
                <Button x:Name="RefreshSystemButton" Width="140" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshSystemButton_OnClick">Refresh State</Button>
                <Button x:Name="ServicesButton" Width="140" Style="{StaticResource SecondaryButtonStyle}" Click="ServicesButton_OnClick">Open Services</Button>
                <Button x:Name="RefreshButton" Width="140" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_OnClick" Visibility="Collapsed">Refresh (Legacy)</Button>
            </WrapPanel>

            <!-- ================= READ-ONLY STATUS ================= -->
            <Border Margin="0,24,0,0" Style="{StaticResource CardStyle}">
                <Expander Header="🔍 Lihat Detail Sistem Lengkap (Read-Only Status)" FontSize="16" FontWeight="SemiBold">
                    <WrapPanel Margin="0,24,0,0">
                        <StackPanel Width="400" Margin="0,0,40,0">
                            <TextBlock Text="Status QEMU Guest Agent" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Account Mode" />
                            <TextBlock x:Name="AdminStateText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Service Name" />
                            <TextBlock x:Name="DisplayNameText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Current Status" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Startup Mode" />
                            <TextBlock x:Name="StartModeText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Binary Path" />
                            <TextBlock x:Name="BinaryPathText" Style="{StaticResource ValueStyle}" />
                            
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Last Action Message" />
                            <TextBlock x:Name="LastActionText" Style="{StaticResource ValueStyle}" />
                            <TextBlock x:Name="GuidanceText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </StackPanel>

                        <StackPanel Width="400">
                            <TextBlock Text="Status Kebijakan Windows" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Power Button AC" />
                            <TextBlock x:Name="PowerButtonAcText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Power Button DC" />
                            <TextBlock x:Name="PowerButtonDcText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Sleep After" />
                            <TextBlock x:Name="SleepAfterText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Keep-Awake Task" />
                            <TextBlock x:Name="KeepAwakeTaskText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="VM Guest Shutdown Service" />
                            <TextBlock x:Name="VmGuestShutdownText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Windows Update Auto-Restart" />
                            <TextBlock x:Name="WindowsUpdateRestartText" Style="{StaticResource ValueStyle}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Power Menu Policy" />
                            <TextBlock x:Name="PowerMenuPolicyText" Style="{StaticResource ValueStyle}" />
                            
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Last Windows Action" />
                            <TextBlock x:Name="SystemActionText" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </Border>

            <!-- ================= NOTES ================= -->
            <Border Margin="0,16,0,32" Style="{StaticResource CardStyle}">
                <Expander Header="📖 Catatan &amp; Bantuan" FontSize="16" FontWeight="SemiBold">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Margin="0,0,0,8" Text="• Kalau provider mematikan VM langsung di level host, Windows di dalam guest tetap tidak bisa menahan itu. Tool ini menahan jalur guest/Windows yang masih bisa dikontrol." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="14" />
                        <TextBlock Margin="0,0,0,8" Text="• Power menu policy hanya berlaku untuk user Windows yang sedang login. QEMU-GA dan scheduled task tetap bisa butuh administrator tergantung konfigurasi mesin." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="14" />
                        <TextBlock Text="• Mode Headless: jalankan dengan argumen --keep-awake untuk mode background, --export-state &lt;path&gt; untuk snapshot JSON, dan --system-action install-keep-awake untuk memasang task." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="14" />
                    </StackPanel>
                </Expander>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
