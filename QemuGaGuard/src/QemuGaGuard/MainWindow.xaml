<Window x:Class="QemuGaGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anti Shutdown Guard"
        Width="980"
        Height="860"
        MinWidth="900"
        MinHeight="720"
        Background="#081019"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111B26" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0D1620" />
        <SolidColorBrush x:Key="LineBrush" Color="#223243" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#39D0A5" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F3C969" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF7D72" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#081019" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="#162333" BorderBrush="#28405A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="#6C2730" BorderBrush="#9A3341" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB7FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="62" Height="32">
                            <Border x:Name="Track"
                                    CornerRadius="16"
                                    Background="#53606D"
                                    BorderBrush="#6A7886"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Knob"
                                     Width="26"
                                     Height="26"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#E8EEF5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#081019" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Knob" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#10202D" />
            <Setter Property="BorderBrush" Value="#24415B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="90" Height="90" CornerRadius="20" Background="#132234" BorderBrush="#23415B" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AS" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Guard" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Anti Shutdown Guard" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Satu utility untuk QEMU Guest Agent, power button AC, keep-awake background, dan policy power menu user saat ini."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                    </StackPanel>

                    <Border Grid.Column="3"
                            CornerRadius="999"
                            Padding="14,8"
                            Background="#132738"
                            BorderBrush="#22405B"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ServiceBadgeText"
                                   Text="Checking"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="QEMU Guest Agent" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,18"
                                   Text="Disable akan stop service QEMU-GA dan set startup ke Disabled. Enable akan mengembalikan startup ke Automatic."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Account Mode" />
                        <TextBlock x:Name="AdminStateText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Display Name" />
                        <TextBlock x:Name="DisplayNameText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Current Status" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Startup Mode" />
                        <TextBlock x:Name="StartModeText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Binary Path" />
                        <TextBlock x:Name="BinaryPathText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                    <StackPanel>
                        <TextBlock Text="QEMU Actions" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,18"
                                   Text="Aksi ini butuh administrator kalau service QEMU-GA terpasang."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13" />

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="QEMU Guest Agent" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="QemuToggleStatusText"
                                               Margin="0,5,0,0"
                                               Text="Checking"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="QemuServiceToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource SwitchToggleStyle}"
                                              VerticalAlignment="Center"
                                              Click="QemuServiceToggle_OnClick" />
                            </Grid>
                        </Border>

                        <WrapPanel>
                            <Button x:Name="RefreshButton" Width="140" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_OnClick">Refresh</Button>
                        </WrapPanel>

                        <WrapPanel>
                            <Button x:Name="ElevateButton" Width="220" Style="{StaticResource SecondaryButtonStyle}" Click="ElevateButton_OnClick">Relaunch as Admin</Button>
                            <Button x:Name="ServicesButton" Width="170" Style="{StaticResource SecondaryButtonStyle}" Click="ServicesButton_OnClick">Open Services</Button>
                        </WrapPanel>

                        <Border Margin="0,10,0,16" CornerRadius="12" Padding="14" Background="#10202D" BorderBrush="#24415B" BorderThickness="1">
                            <TextBlock x:Name="GuidanceText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                        </Border>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Last QEMU Action" />
                        <TextBlock x:Name="LastActionText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Windows Power Guard" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,18"
                                   Text="Bagian ini mengatur sisi Windows guest: tombol power AC, task keep-awake, dan menu power untuk user yang sedang login."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Power Button AC" />
                        <TextBlock x:Name="PowerButtonAcText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Power Button DC" />
                        <TextBlock x:Name="PowerButtonDcText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Sleep After" />
                        <TextBlock x:Name="SleepAfterText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Keep-Awake Task" />
                        <TextBlock x:Name="KeepAwakeTaskText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="VM Guest Shutdown Service" />
                        <TextBlock x:Name="VmGuestShutdownText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Windows Update Auto-Restart" />
                        <TextBlock x:Name="WindowsUpdateRestartText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Power Menu Policy" />
                        <TextBlock x:Name="PowerMenuPolicyText" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                    <StackPanel>
                        <TextBlock Text="Windows Actions" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,18"
                                   Text="Keep-awake memakai SetThreadExecutionState dari process ini sendiri. Tidak ada autoclick, mouse move, atau input keyboard palsu."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="13" />

                        <WrapPanel>
                            <Button x:Name="ApplyHardeningButton" Width="210" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyHardeningButton_OnClick">Apply Hardening</Button>
                            <Button x:Name="RefreshSystemButton" Width="120" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshSystemButton_OnClick">Refresh</Button>
                        </WrapPanel>

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="AC Power Button Guard" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AcPowerToggleStatusText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="AcPowerGuardToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center" Click="AcPowerGuardToggle_OnClick" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Keep-Awake Task" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="KeepAwakeToggleStatusText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="KeepAwakeToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center" Click="KeepAwakeToggle_OnClick" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sleep Never" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SleepNeverToggleStatusText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="SleepNeverToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center" Click="SleepNeverToggle_OnClick" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Power Menu Guard" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PowerMenuToggleStatusText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="PowerMenuGuardToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center" Click="PowerMenuGuardToggle_OnClick" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="VM Guest Shutdown Block" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VmShutdownToggleStatusText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="VmShutdownBlockToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center" Click="VmShutdownBlockToggle_OnClick" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ToggleRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Windows Update Restart Block" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WindowsUpdateToggleStatusText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <ToggleButton x:Name="WindowsUpdateRestartToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center" Click="WindowsUpdateRestartToggle_OnClick" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Last Windows Action" />
                        <TextBlock x:Name="SystemActionText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Style="{StaticResource CardStyle}" Background="#0F1823">
                <StackPanel>
                    <TextBlock Text="Notes" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,12,0,8"
                               Text="Kalau provider mematikan VM langsung di level host, Windows di dalam guest tetap tidak bisa menahan itu. Tool ini menahan jalur guest/Windows yang masih bisa dikontrol."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <TextBlock Margin="0,0,0,8"
                               Text="Power menu policy hanya berlaku untuk user Windows yang sedang login. QEMU-GA dan scheduled task tetap bisa butuh administrator tergantung konfigurasi mesin."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                    <TextBlock Text="Headless: --keep-awake untuk mode background, --export-state &lt;path&gt; untuk snapshot JSON, dan --system-action install-keep-awake untuk memasang task."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
