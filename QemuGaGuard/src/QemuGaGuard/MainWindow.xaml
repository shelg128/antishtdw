<Window x:Class="QemuGaGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QEMU Guest Agent Guard"
        Width="940"
        Height="720"
        MinWidth="860"
        MinHeight="640"
        Background="#081019"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111B26" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0D1620" />
        <SolidColorBrush x:Key="LineBrush" Color="#223243" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#39D0A5" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F3C969" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF7D72" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#081019" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="#162333" BorderBrush="#28405A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="#6C2730" BorderBrush="#9A3341" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB7FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="90" Height="90" CornerRadius="20" Background="#132234" BorderBrush="#23415B" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="QG" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Guard" Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="QEMU Guest Agent Guard" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Utility lokal untuk melihat status QEMU Guest Agent lalu enable atau disable lagi tanpa masuk Services secara manual."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="14" />
                </StackPanel>

                <Border Grid.Column="3"
                        CornerRadius="999"
                        Padding="14,8"
                        Background="#132738"
                        BorderBrush="#22405B"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ServiceBadgeText"
                               Text="Checking"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Service State" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,18"
                               Text="Target utama dari shutdown otomatis di mesin audit tadi adalah service QEMU Guest Agent."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Account Mode" />
                    <TextBlock x:Name="AdminStateText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Display Name" />
                    <TextBlock x:Name="DisplayNameText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Current Status" />
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Startup Mode" />
                    <TextBlock x:Name="StartModeText" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Binary Path" />
                    <TextBlock x:Name="BinaryPathText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="{StaticResource PanelAltBrush}">
                <StackPanel>
                    <TextBlock Text="Actions" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,10,0,18"
                               Text="Disable akan stop service dan ubah startup ke Disabled. Enable akan kembalikan startup ke Automatic lalu start lagi."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />

                    <WrapPanel>
                        <Button x:Name="EnableButton" Width="150" Style="{StaticResource PrimaryButtonStyle}" Click="EnableButton_OnClick">Enable</Button>
                        <Button x:Name="DisableButton" Width="150" Style="{StaticResource DangerButtonStyle}" Click="DisableButton_OnClick">Disable</Button>
                        <Button x:Name="RefreshButton" Width="140" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_OnClick">Refresh</Button>
                    </WrapPanel>

                    <WrapPanel>
                        <Button x:Name="ElevateButton" Width="220" Style="{StaticResource SecondaryButtonStyle}" Click="ElevateButton_OnClick">Relaunch as Admin</Button>
                        <Button x:Name="ServicesButton" Width="170" Style="{StaticResource SecondaryButtonStyle}" Click="ServicesButton_OnClick">Open Services</Button>
                    </WrapPanel>

                    <Border Margin="0,10,0,16" CornerRadius="12" Padding="14" Background="#10202D" BorderBrush="#24415B" BorderThickness="1">
                        <TextBlock x:Name="GuidanceText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
                    </Border>

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Last Action" />
                    <TextBlock x:Name="LastActionText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Background="#0F1823">
            <StackPanel>
                <TextBlock Text="Notes" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,12,0,8"
                           Text="Kalau provider mematikan VM langsung di level host, Windows di dalam guest tetap tidak bisa menahan itu. Tool ini hanya mengontrol QEMU Guest Agent di sisi guest."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           FontSize="13" />
                <TextBlock Margin="0,0,0,8"
                           Text="State default service yang terdeteksi saat audit adalah Auto + Running. Enable di tool ini mengembalikan ke mode itu."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           FontSize="13" />
                <TextBlock Text="Untuk verifikasi tanpa membuka UI, executable ini mendukung argumen --export-state &lt;path&gt; agar menulis snapshot status ke file JSON."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           FontSize="13" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
